# Gionee GN3002 (mt6735) — 设备 init 配置 — LineageOS 14.1
#
# 位置：/init.mt6735.rc（ramdisk 根）
#
# 7.1 的 init 在解析完 AOSP 的 /init.rc 之后会 import
#   /init.${ro.hardware}.rc
# 也就是本文件（ro.hardware = mt6735）。
#
# 8.1 的路径是 /vendor/etc/init/hw/init.${ro.hardware}.rc（多两层目录）；
# 7.1 直接在 ramdisk 根。写错位置的表现是「设备服务一个都没起」，
# 但系统本身照常开机，非常难发现。
#
# 这里刻意只放「不阻塞开机」的最小服务集。原厂 init.mt6735.rc 有 1543 行、
# 几十个服务（modem / wifi / bt / aee / xlog / touch ...），一次性全搬过来
# 只会在 bring-up 阶段制造噪音。正确做法是先让 framework 起来，
# 再按 logcat / dmesg 的实际报错逐个加回。
#
# ★ 写这份 rc 的两条铁律
#   1. init 的动作是「某条命令失败就中止该动作剩余命令」。
#      所以每个动作里最关键的挂载命令放第一条，可能失败的辅助命令放后面。
#   2. 命令名 / 参数个数必须严格合法，否则该行被解析器静默跳过。
#      改动后跑：python tools/check_init_rc.py phoenix/rootdir/init.mt6735.rc

# ------------------------------------------------------------------------------
# NVRAM / 温控 / 电量计 / 蓝牙（原厂 blobs）
# ------------------------------------------------------------------------------
service nvram_daemon /system/vendor/bin/nvram_daemon
    class main
    user root
    group system
    oneshot

service thermal_manager /system/vendor/bin/thermal_manager
    class main
    user root
    oneshot

service fuelgauged /system/vendor/bin/fuelgauged
    class main
    user system
    group system

service mtkbt /system/vendor/bin/mtkbt
    class late_start
    socket bt.int.adp dgram 660 bluetooth net_bt
    socket bt.a2dp.stream dgram 660 bluetooth net_bt
    user bluetooth
    group system vpn net_admin inet net_raw net_bt bluetooth net_bt_admin net_bt_stack sdcard_r

# ------------------------------------------------------------------------------
# 基带（RIL）—— MTK 必须用 mtkrild + ccci_mdinit，AOSP 通用 rild 起不来 socket
# 2026-11-28 实机：通用 rild 进程在跑但 "Couldn't find 'rild' socket"，
# RILJ 一直 RADIO_NOT_AVAILABLE -> 基带/信号不显示。
# ------------------------------------------------------------------------------
# modem 初始化（oneshot）。加载 modem firmware 并建立 CCCI 通道。
# 与 mtkrild 同为 class main；mtkrild 内部会等待 CCCI 就绪，顺序不敏感。
service ccci-mdinit /system/vendor/bin/ccci_mdinit
    class main
    user root
    group root system radio
    oneshot

# MTK RIL：覆盖 AOSP 的通用 rild。socket 名必须是 rild（RILJ 找它）。
service ril-daemon /system/vendor/bin/mtkrild
    class main
    user root
    group radio cache inet misc audio sdcard_rw log
    socket rild stream 660 root radio
    socket rild-debug stream 660 radio system

# ------------------------------------------------------------------------------
# WiFi —— wpa_supplicant（原厂 5.1 blobs，从 factory ROM 提取）
# 2026-11-28 实机：镜像里完全没有 wpa_supplicant，WiFi HAL 起不来。
# ------------------------------------------------------------------------------
# 用配置文件里的 ctrl_interface 建 socket；7.1 WifiNative 默认找
# /data/misc/wifi/wpa_wlan0（与 wpa_supplicant.conf 的 ctrl_interface 一致）。
service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -e/data/misc/wifi/entropy.bin
    class main
    user wifi
    group wifi inet keystore
    oneshot

# ------------------------------------------------------------------------------
# ★ 为什么挂载/建目录都放在 early-fs / fs / late-fs / early-boot 这四个段里
#
# init 的规则：**同一个 trigger 下的命令，前一条失败会中止后面所有命令**。
# 而 AOSP /init.rc 在第 9 行就 import 本文件（import /init.${ro.hardware}.rc），
# 比它自己的 on post-fs / on post-fs-data / on boot 段更早被解析，
# 所以本文件里同名 trigger 的命令会**排在 AOSP 命令前面**。
# 后果：若把可能失败的命令（mount / mkdir）写进 on post-fs-data，
# 一旦失败，AOSP 的 start vold / start debuggerd 会被一起跳过 —— 非常难查。
#
# 实测 AOSP init.rc 中**没有定义**以下四个段，本文件可独占，
# 独占段里出错只影响自己：
#     early-fs   （late-init 里第一个 trigger）
#     fs         （7.1 的挂载入口）
#     late-fs    （在 post-fs 之后、load_system_props 之后）
#     early-boot （在 post-fs-data 之后、boot 之前）
# 共享段（post-fs / post-fs-data / boot / nonencrypted）里只放 write 一个
# checkpoint，写 /cache 基本不会失败；万一失败也只波及自己那几条。
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# early-fs（独占）：先挂 /cache，把可观测通道建起来
#
# mount 的 wait 关键字 = wait_for_file(dev, 5s)（builtins.cpp do_mount）。
#
# ★ 2026-11-27 实测教训：init 的 mount 命令失败时**完全静默**（只返回 -1，
#   不写任何日志），而失败会中止本段剩余命令 —— 于是 checkpoint 全丢，
#   现象只是"/cache/gn3002 不存在"，无法反推原因。
#   因此：每一步都用 write /dev/kmsg 记一条，内核日志是唯一必然可读的通道
#   （即使 /cache 没挂上也能看到）。另外 /cache 已加回 fstab 由 fs_mgr 兜底，
#   所以这里失败也不致命。
# ------------------------------------------------------------------------------
on early-fs
    write /dev/kmsg "<3>gn3002: A early-fs entered"
    mount ext4 /dev/block/mmcblk0p21 /cache wait
    write /dev/kmsg "<3>gn3002: B mount /cache returned"
    mkdir /cache/gn3002 0770 root root
    write /dev/kmsg "<3>gn3002: C mkdir /cache/gn3002 returned"
    write /data/gn3002/r0-early-fs-cache-mounted.txt ok
    write /dev/kmsg "<3>gn3002: D write r0 returned"
    # /data 也先试一次：/cache 挂载在这台机器上不稳定，而 /data 必须挂上
    # （framework 起不来就是它没挂）。bootlog.sh 会优先往 /data 写。
    mount ext4 /dev/block/mmcblk0p22 /data wait
    write /dev/kmsg "<3>gn3002: E mount /data returned"
    mkdir /data/gn3002 0770 root root
    write /data/gn3002/r0-early-fs-data-mounted.txt ok
    write /dev/kmsg "<3>gn3002: F write /data r0 returned"

# ------------------------------------------------------------------------------
# fs（独占）：真正的挂载（7.1 的挂载入口，必须写在设备 rc 里）
#
# AOSP /init.rc 的 on fs 段里只有一句注释：
#   # Mount fstab in init.{$device}.rc by mount_all command.
# 即 7.1 约定由设备自己的 init.<hw>.rc 负责挂载（和 8.1 完全相反，
# 8.1 的挂载全在 init 的 C++ 里）。两边都不写就谁都没挂 → /system 空。
#
# device 节点一定已经在了：AOSP init main() 在 early-init 之后先跑
# wait_for_coldboot_done_action（等 ueventd 建出 /dev/.coldboot_done），
# 然后才 queue init / late-init；而 handle_block_device_event() 对每个块设备
# 无条件建 /dev/block/<name>。所以 mmcblk0p20 在 fs 阶段必然存在。
#
# mount_all 必须是本段第一条：它返回 -1 时 init 不会 queue "nonencrypted"，
# 而 class_start main（zygote/servicemanager/surfaceflinger）就在那里。
# （fstab 里两个分区都带 nofail，就是为了让 error_count 保持 0，见 B15。）
# ------------------------------------------------------------------------------
on fs
    mount_all /fstab.mt6735
    write /dev/kmsg "<3>gn3002: fs mount_all returned ok"
    write /data/gn3002/r1-fs-mount-all-returned.txt ok

# ------------------------------------------------------------------------------
# late-fs（独占）：兜底再挂一次 /system
#
# 若 mount_all 没把 /system 挂上，这里直接补一次；已挂上会 EBUSY。
# 放在独占段里，失败不会波及 AOSP 的 start logd 等命令。
# late-fs 在 post-fs 之后触发，此时 logd 已起、/system 属性即将/已经加载。
# ------------------------------------------------------------------------------
on late-fs
    write /dev/kmsg "<3>gn3002: late-fs entered"
    mount ext4 /dev/block/mmcblk0p20 /system ro wait
    write /dev/kmsg "<3>gn3002: late-fs system mount attempted"
    write /data/gn3002/r3-late-fs-system-mounted.txt ok

# ------------------------------------------------------------------------------
# early-boot（独占）：/data 目录 + 设备节点权限
#
# 这几条都放这里而不是 on boot，因为 on boot 是和 AOSP 共享的段
# （AOSP 在那里做 class_start core，logd / adbd 全在 core 类）。
# chown/chmod 对不存在的节点会返回失败，一旦失败就会把 class_start core
# 一起跳过 —— logd 不起就没有 logcat，adbd 不起就连不上。放独占段最安全。
#
# 这些节点在 early-boot 阶段都已存在：ueventd 的 coldboot 很早就完成，
# /proc/mtk_battery_cmd 由 PMIC 驱动 probe 时创建。
#
# 触摸是汇顶 FT8606 / 敦泰，走 input 子系统；PMIC 的充电节点要能被 framework 读。
# ------------------------------------------------------------------------------
on early-boot
    mkdir /data/nvram 0771 root root
    mkdir /data/nvram/APCFG 0771 root root
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/bluetooth 0770 bluetooth bluetooth
    write /data/gn3002/r5-early-boot-dirs.txt ok
    chown system system /proc/mtk_battery_cmd
    chmod 0660 /proc/mtk_battery_cmd
    # 7.1 的外部存储走 FUSE（内核没有 sdcardfs），把 fuse 设备放开
    chmod 0666 /dev/fuse

# ------------------------------------------------------------------------------
# ★★ 共享 trigger 里一条命令都不要写（2026-11-28 血的教训）★★
#
# 曾经在 on boot 里写了一句 `write /data/gn3002/r6-boot.txt ok` 当作阶段标记。
# 而 /cache 的挂载在这台机器上并不稳定：那一句失败后，init 按"动作内失败即中止"
# 的规则**跳过了 AOSP 后面的 `class_start core`** —— 于是 logd / adbd / bootlog
# 全都没起来：没有 logcat、没有 adb shell、bootlog 一个文件也没写。
# 表面上只表现为"bootlog 没输出"，极难联想到是被自己的一句 write 拖死的。
#
# 结论：post-fs / post-fs-data / boot / nonencrypted 这些**与 AOSP 共享**的段，
# 本文件一条命令都不放。阶段标记只写在：
#   - 独占段（early-fs / fs / late-fs / early-boot）
#   - 独有的 property 触发（on property:init.svc.zygote=running）
# 并且在独占段内，标记用 `write /dev/kmsg`（已验证可用）而不是写文件。
# ------------------------------------------------------------------------------
# ★ 这里原本是 `on nonencrypted`（与 AOSP 共享，AOSP 在其中做 class_start main）。
#   为了绝不给共享动作注入任何可能失败的命令，改成监听 zygote 属性 ——
#   zygote 在 main 类里、由 AOSP 的 class_start main 启动，所以
#   "init.svc.zygote=running" 出现，等价于 main 类已经起来了。
on property:init.svc.zygote=running
    write /dev/kmsg "<3>gn3002: zygote running (main class started)"

# ------------------------------------------------------------------------------
# 默认开启 ADB（2026-11-28 实机验证）
# persist.sys.usb.config=none 会持久化到 /data/property，改 default.prop 无效。
# sys.boot_completed=1 时 /data 已挂载、persist 已加载，此时强制重设。
# ------------------------------------------------------------------------------
on property:sys.boot_completed=1
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb

# ------------------------------------------------------------------------------
# 日志落盘（★ 本项目最重要的调试设施，也是唯一能拿到 logcat 的途径）
#
# last_kmsg 是内核 ram console 的 64 KB 环形缓冲，日志量大时 60 秒就绕回、
# 硬断电更是整块丢失。所以由本服务定期把 dmesg / logcat / logcat -b crash
# 刷到持久分区。
#
# 为什么优先写 /data：/cache（p21）在这台机器上的挂载不稳定（fs_mgr 报 EBUSY），
# 实测 /cache/gn3002 经常一个文件都没有；而 /data（p22，25 GB）必须挂上，
# 否则 framework 根本起不来。所以 /data 是更可靠的落点。
#
# 若本服务没跑起来，现象是 /data/gn3002 目录存在但为空 ——
# 这时要怀疑 class_start core 被跳过（见上面"共享 trigger"那段注释）。
# ------------------------------------------------------------------------------
service bootlog /system/bin/sh /sbin/bootlog.sh
    class core
    user root
    group root system log
    oneshot
    # ★ 必须显式指定域。7.1 的 init 对没有 seclabel、又没有 service_contexts
    #   条目的服务会打 "does not have a SELinux domain defined"，
    #   实测该服务从未真正起来（/data/gn3002 一直是空的）。
    #   用 init 自己的域：既能执行 /system/bin/sh，也有权写 /data。
    seclabel u:r:init:s0
